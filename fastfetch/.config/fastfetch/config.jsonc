{
	"$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
	"logo": {
		"color": {
			"1": "red",
			"2": "red"
		},
		"source": "$(find \"${XDG_CONFIG_HOME:-$HOME/.config}/fastfetch/png/\" -name \"*.png\" | shuf -n 1)",
//    "source": "$HOME/.config/fastfetch/ascii/rose.txt",
"padding": {
	"top": 1,
	"right": 5
},
"height": 18
	},
	"display": {
		"separator": " "
	},
	"modules": [
		{
			"type": "title",
			"keyColor": "red",
			"color": "red"
		},
		"break",
		{
			"type": "custom",
			"format": "┌─── Other",
			"outputColor": "red"
		},
		{
			"type": "os",
			"key": "",
			"keyColor": "red",
			"outputColor": "white"
		},
		{
			"type": "kernel",
			"key": "",
			"keyColor": "red",
			"outputColor": "white"
		},
		{
			"type": "de",
			"key": "",
			"keyColor": "red",
			"outputColor": "white"
		},
		{
			"type": "wm",
			"key": "",
			"keyColor": "red",
			"outputColor": "white"
		},
		{
			"type": "packages",
			"key": "",
			"keyColor": "red",
			"outputColor": "white"
		},
		{
			"type": "custom",
			"format": "└───",
			"outputColor": "red"
		},
		{
			"type": "custom",
			"format": "┌─── Other",
			"outputColor": "red"
		},
		{
			"type": "memory",
			"key": "",
			"keyColor": "red",
			"outputColor": "white"
		},
		{
			"type": "host",
			"key": "",
			"keyColor": "red",
			"outputColor": "white"
		},
		{
			"type": "cpu",
			"key": "",
			"keyColor": "red",
			"outputColor": "white"
		},
		{
			"type": "gpu",
			"key": "",
			"keyColor": "red",
			"outputColor": "white"
		},
		{
			"type": "swap",
			"key": "",
			"keyColor": "red",
			"outputColor": "white"
		},
		{
			"type": "disk",
			"key": "",
			"keyColor": "red",
			"outputColor": "white"
		},
		{
			"type": "battery",
			"key": "",
			"keyColor": "red",
			"outputColor": "white"
		},
		{
			"type": "custom",
			"format": "└───",
			"outputColor": "red"
		},
		{
			"type": "custom",
			"format": "┌─── Other",
			"outputColor": "red"
		},
		{
			"type": "uptime",
			"key": "",
			"keyColor": "red",
			"outputColor": "white"
		},
		{
			"type": "terminal",
			"key": "",
			"keyColor": "red",
			"outputColor": "white"
		},
		{
			"type": "locale",
			"key": "",
			"keyColor": "red",
			"outputColor": "white"
		},
		{
			"type": "custom",
			"format": "└───",
			"outputColor": "red"
		},
		"break"
	]
}
